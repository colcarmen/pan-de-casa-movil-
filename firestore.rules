rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de productos: Lectura pública, escritura para usuarios autenticados o admin
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null || true; // Modo desarrollo
    }

    // Pedidos de clientes: Seguimiento en tiempo real y creación
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Perfiles de usuario (roles CLIENT y ADMIN)
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
